# Copie para .env e preencha. Sem MERCHANT_ID/KEY o checkout roda em MODO SIMULAÇÃO.
PORT=3000

# sandbox | production
CIELO_AMBIENTE=sandbox

# Credenciais da API E-commerce Cielo 3.0
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=

# Credenciais do Silent Order Post (peça ao suporte e-commerce da Cielo)
CIELO_SOP_CLIENT_ID=
CIELO_SOP_CLIENT_SECRET=

# Nome que aparece na fatura do cartão (até 13 caracteres, sem espaço/acento)
SOFT_DESCRIPTOR=MINHALOJA

# Parcelamento
MAX_PARCELAS=12
PARCELAS_SEM_JUROS=1
JUROS_MES=2.99

# Shopify (app personalizado com escopos read_products e write_orders)
SHOPIFY_LOJA=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Frete para carrinhos da Shopify (em reais). 0 = grátis
FRETE_FIXO=19.90
FRETE_GRATIS_ACIMA=299

# Link do botão "Voltar para a loja" na tela de sucesso
LOJA_URL=https://sualoja.com.br

# Banco de dados (SQLite). Na hospedagem, aponte para um disco/volume persistente, ex.: /data/checkout.db
DB_ARQUIVO=./dados/checkout.db

# Senha das rotas /admin (gere uma longa: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
ADMIN_TOKEN=
